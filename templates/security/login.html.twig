{% extends 'user/authBase.html.twig' %}

{% set image_path = '/images/loginImage.jpg' %}
{% set image_alt = 'Image d\'une mère et un enfant' %}

{% block title %}Se connecter{% endblock %}

{% block form_title %}Bienvenue chez VetEnfant{% endblock %}

{% block form_content %}
<form method="POST" action="{{ path('app_login') }}">
    {% if error %}
    <div class="alert alert-danger">
        {{ error.messageKey|trans(error.messageData, 'security') }}
    </div>
    {% endif %}

    {% if app.user %}
    <div class="alert alert-info">
        Vous êtes connecté en tant que {{ app.user.userIdentifier }},
        <a href="{{ path('app_logout') }}">Se déconnecter</a>.
    </div>
    {% endif %}

    <div class="form-floating mb-3">
        <input type="email" class="form-control" name="email" value="{{ last_username }}" id="inputEmail"
            placeholder="Email" required>
        <label for="inputEmail">Email</label>
    </div>

    <div class="mb-4 position-relative">
        <div class="form-floating">
            <input type="password" name="password" id="inputPassword" placeholder="Mot de passe" required
                   class="form-control password-field" autocomplete="current-password">
            <label for="inputPassword">Mot de passe</label>
        </div>
        <span class="position-absolute top-50 end-0 translate-middle-y me-3 password-icon" style="cursor: pointer;">
        </span>
    </div>
    

    <a class="text-muted" href="{{ path('app_reset_password') }}">Mot de passe perdu ?</a>

    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

    <div class="d-grid">
        {{ include('components/button.html.twig', { class: 'btn-general', label: 'Se connecter', type: 'submit' }) }}
    </div>
</form>

<div class="text-center mt-5">
    <p class="mb-0 text-secondary">
        Vous n’avez pas encore de compte ?
        <a href="{{ path('app_register') }}" class="link-warning text-decoration-none">Créer un compte</a>
    </p>
</div>

{% endblock %}