<div class="col-md-4 col-lg-4 col-xl-3 mb-5"> <!-- mb-5 pour espacement supplémentaire -->
    <div class="single-product">
        <div class="product-header">
            {% if product.image is not empty %}
            <div class="image-container">
                <img src="{{ asset('assets/uploads/products/mini/300x300-' ~ product.image[0].src ) }}"
                    alt="{{ product.name }}" class="product-image">
            </div>
            {% else %}
            <div
                class="image-container bg-light text-muted d-flex justify-content-center align-items-center">
                <p>Image non disponible</p>
            </div>
            {% endif %}
        </div>
        <div class="product-content">
            <div class="d-flex justify-content-between align-items-center w-100">
                {% if product.slug is not empty %}
                <a class="text-decoration-none product-title text-muted"
                    href="{{ path('product_details', {'slug': product.slug}) }}">
                    <h3 class="product-title mb-0">{{ product.name }}</h3>
                </a>
                {% else %}
                <p>Ce produit n'a pas de lien valide.</p>
                {% endif %}
                <i class="fa fa-heart favorite-icon" aria-hidden="true"></i>
            </div>
            <h4 class="product-subTitle mt-4">
                {{ product.description|length > 100 ? product.description[:100] ~ '...' : product.description }}
            </h4>
            <h5 class="product-price mt-3">{{ product.price | number_format(2, ',', ' ') }} €</h5>
        </div>
    </div>
</div>