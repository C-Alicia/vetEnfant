<div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
    <!-- Ajusté pour plus de flexibilité -->
    <div class="card"
         style="width: 100%; border: 1px solid #ddd; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
        <div class="card-header p-2" style="height: 150px; overflow: hidden;">
         {#    {% if product.image is not empty %}
                <img src="{{ asset('assets/uploads/products/' ~ product.image[0].src) }}"
                     alt="{{ product.name }}" class="card-img-top"
                     style="width: 100%; height: 100%; object-fit: cover;">
            {% else %}
                <div class="bg-light text-muted d-flex justify-content-center align-items-center"
                     style="height: 100%; width: 100%;">
                    <p>Image non disponible</p>
                </div>
            {% endif %} #}

        </div>
        <div class="card-body p-2">
            {% if product.slug is not empty %}
                <a href="{{ path('product_details', {'slug': product.slug}) }}"
                   class="text-decoration-none text-dark">
                    <h5 class="card-title small">{{ product.name }}</h5>
                </a>
            {% else %}
                <h5 class="card-title small">Nom non disponible</h5>
            {% endif %}
            <p class="card-text small">
                {{ product.description|length > 50 ? product.description[:50] ~ '...' : product.description }}
            </p>
            <p class="card-price">{{ product.price | number_format(2, ',', ' ') }} €</p>
        </div>
    </div>
</div>
