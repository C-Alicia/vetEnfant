<div class="col-12 d-flex flex-column align-items-start mt-4">
    <!-- Conteneur pour l'icône et le titre alignés sur la même ligne -->
    <div class="d-flex align-items-center mb-2">
        <i class="{{ icon_class }} fs-4 me-2"></i>  <!-- Icône de taille plus petite -->
        <h1 class="fs-6 mb-0 font-weight-bold">{{ title }}</h1>  <!-- Titre aligné à côté de l'icône -->
    </div>

    <!-- Texte des articles en dessous du titre, aligné avec le titre -->
{#     <p class="fs-7 text-muted mb-0 ms-4">0 articles</p> #}  <!-- Nombre d'articles aligné au titre -->
</div>