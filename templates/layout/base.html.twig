<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>VetEnfant |
    {% block title %}{% endblock %}</title>
  <link rel="icon" href="{{ asset('/images/LogoVetement.jpg') }}" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

  {% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/app.css') }}" />
  {% endblock %}
  {% block javascripts %}
  <script src="{{ asset('js/app.js') }}"></script>
  {% endblock %}
  {% block importmap %}
  {{
  importmap("app")
  }}
  {% endblock %}
</head>

<body>
  <main>
    <header>
      <nav class="navbar navbar-light bg-white navbar-expand-lg border-bottom fixed-top">
        <div class="container-fluid">
          <a class="navbar-brand me-auto" href="{{path('app_home')}}">
            <img src="{{ asset('/images/LogoVet.png') }}" height="80" alt="Logo" />
          </a>
          <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar"
            aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>

          <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar"
            aria-labelledby="offcanvasNavbarLabel">
            <div class="offcanvas-header">
              <a class="offcanvas-title" href="{{path('app_home')}}" id="offcanvasNavbarLabel">
                <img src="{{ asset('/images/LogoVet.png') }}" height="100" alt="Logo Vetenfant" />
              </a>
              <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
              <ul class="navbar-nav justify-content-center flex-grow-1 pe-3">
                <li class="nav-item">
                  <a class="nav-link" aria-current="page" href="{{path('product_productNew')}}">NOUVEAUTÉS</a>
                  <span class="">0-16 ans</span>
                </li>
                <div class="separator"></div>
                <li class="nav-item text-wrap">
                  <a class="nav-link" href="{{path('product_productBaby')}}">BÉBÉ</a>
                  <span class="">0-3 ans</span>
                </li>
                <div class="separator"></div>
                <li class="nav-item text-wrap">
                  <a class="nav-link" href="{{path('product_productGirl')}}">FILLE</a>
                  <span class="">3-16 ans</span>
                </li>
                <div class="separator"></div>
                <li class="nav-item text-wrap">
                  <a class="nav-link" href="{{path('product_productBoy')}}">GARÇON</a>
                  <span class="">3-16 ans</span>
                </li>
              </ul>
            </div>
          </div>
          <div class="offcanvas-side-body d-none d-sm-block d-md-block">
            <ul class="navbar-nav justify-content-end d-flex flex-row align-items-center">
              {% if app.user %}
              <li class="nav-item">
                <a href="{{ path('product_productSell') }}">
                  {{ include('components/button.html.twig', { class: 'btn-general', label: 'Vends tes articles', type:
                  'submit' }) }}
                </a>
              </li>
              {% else %}
              <li class="nav-item">
                <a href="{{ path('app_login') }}">
                  {{ include('components/button.html.twig', { class: 'btn-general', label: 'Vends tes articles', type:
                  'submit' }) }}
                </a>
              </li>
              {% endif %}
              <li class="nav-item">
                <div class="search-box d-flex align-items-center">
                  <i class="fa fa-search"></i>
                  <input type="text" class="form-control search-input" placeholder="Que recherchez-vous ?" />
                </div>
              </li>

              <div class="dropdown">
                <button class="btn dropdown-toggle" type="button" id="customDropdown" data-bs-toggle="dropdown"
                  aria-expanded="false">
                  {% if app.user %}
                  <img src="{{ app.user.profileImage }}" height="80" alt="avatar" />
                  Bonjour, {{ app.user.username }}
                  {% else %}
                  <i class="fa fa-user" aria-hidden="false"> Mon compte</i>
                  {% endif %}
                </button>
                <ul class="dropdown-menu mt-2 p-4" aria-labelledby="dropdownMenuButton">
                  {% if app.user %}
                  <li class="nav-item">
                    <a class="nav-link" href="#"><i class="fa fa-user"></i> Mon Profil</a>
                  </li>
                  <li>
                    <hr class="dropdown-divider" />
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" href="#"><i class="fa fa-heart"></i> Mes favoris</a>
                  </li>
                  <li>
                    <hr class="dropdown-divider" />
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" href="#"><i class="fa fa-envelope"></i> Messages</a>
                  </li>
                  <li>
                    <hr class="dropdown-divider" />
                  </li>
                  <li>
                    <form action="{{ path('app_logout') }}" method="post">
                      <button type="submit" class="dropdown-item btn-general text-center">
                        <i class="fa fa-power-off"></i> Se déconnecter
                      </button>
                    </form>
                  </li>
                  {% else %}
                  <li>
                    <strong>Déjà client</strong>
                  </li>
                  <li>
                    <a class="dropdown-item btn-general text-center" href="{{ path('app_login') }}">Me connecter</a>
                  </li>
                  <li>
                    <a class="text-muted" href="">Mot de passe perdu ?</a>
                  </li>
                  <li>
                    <hr class="dropdown-divider" />
                  </li>
                  <li>
                    <strong>Nouveau client</strong>
                  </li>
                  <li>
                    <a class="dropdown-item btn-general text-center" href="{{ path('app_register') }}">Créer un
                      compte</a>
                  </li>
                  {% endif %}
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn dropdown-toggle" type="button" id="cartDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                  <a href=" {{ path('cart_index') }}" >
                    <i class="fa fa-shopping-bag"></i>
                  </a>
                </button>
                <ul class="dropdown-menu mt-2 p-4" aria-labelledby="dropdownMenuButton">
              
                  <li class="nav-item">
                    <a class="nav-link" href="#"><i class="fa fa-user"></i> Mon Profil</a>
                  </li>
                </ul>
                
            </div>
            

              {# <div class="dropdown">
                <button class="btn dropdown-toggle" type="button" id="customDropdown" data-bs-toggle="dropdown"
                  aria-expanded="false">
                  <i class="fa fa-shopping-bag"></i>
                  <span id="cart-counter" class="bg-red-500 text-white text-sm rounded-full px-2">
                    {{ app.session.get('cart')|length }}
                  </span>
                </button>
                <ul class="dropdown-menu mt-2 p-2" aria-labelledby="cartDropdown">
                  {% set cart = app.session.get('cart', {}) %}
                  {% if cart|length > 0 %}
                  {% for product, quantity in cart %}
                  <li class="dropdown-item">
                    Produit ID: {{ product.id }} - Quantité: {{ quantity }}
                  </li>
                  {% endfor %}
                  {% else %}
                  <li class="dropdown-item">Votre panier est vide</li>
                  {% endif %}
                </ul>
              </div> #}

              {# <li class="nav-item">
                <a href="{{ path('cart_index') }}" class="nav-link relative">
                  <i class="fa fa-shopping-bag "></i>
                  <span id="cart-counter"
                    class="absolute top-0 right-0 bg-red-500 text-white text-sm rounded-full px-2">4</span>
                </a>
              </li> #}
              <li class="nav-item">
                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin') }}" class="nav-link">
                  <i class="fa fa-lock" aria-hidden="true"></i>
                  {% endif %}
                </a>
              </li>
            </ul>
          </div>
        </div>
      </nav>
    </header>

    {% block body %}{% endblock %}

    {# footer #}

    <div class="container-fluid p-0">
      <footer class="footer text-lg-start text-dark">
        <section class="d-flex justify-content-between p-4">
          <div class="container text-center text-md-start mt-5">
            <div class="row mt-3">
              <!-- Réseaux sociaux -->
              <div class="col-md-3 col-lg-4 col-xl-3 mx-auto mb-4">
                <h6 class="footer-title">Suivez-nous sur nos réseaux sociaux</h6>
                <hr class="footer-divider" />
                <div class="social-icons">
                  <a href="#"><i class="fa-brands fa-facebook fa-lg"></i></a>
                  <a href="#"><i class="fa-brands fa-twitter fa-lg"></i></a>
                  <a href="#"><i class="fa-brands fa-instagram fa-lg"></i></a>
                  <a href="#"><i class="fa-brands fa-youtube fa-lg"></i></a>
                </div>
                <p class="mt-3">Promis, ici, les enfants ressemblent <br> aux vôtres.</p>
              </div>
              <!-- Contact et aide -->
              <div class="col-md-2 col-lg-2 col-xl-2 mx-auto mb-4">
                <h6 class="footer-title">Contact et aide</h6>
                <hr class="footer-divider" />
                <p><a href="#" class="footer-link">Livraison</a></p>
                <p><a href="#" class="footer-link">Nous écrire</a></p>
                <p><a href="#" class="footer-link">FAQ</a></p>
                <p><a href="#" class="footer-link">Guide des tailles</a></p>
              </div>
              <!-- À propos de VetEnfant -->
              <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mb-4">
                <h6 class="footer-title">Ça c'est VetEnfant</h6>
                <hr class="footer-divider" />
                <p><a href="#" class="footer-link">À propos de VetEnfant</a></p>
                <p><a href="#" class="footer-link">Autres</a></p>
                <p><a href="#" class="footer-link">Autres</a></p>
                <p><a href="#" class="footer-link">Autres</a></p>
              </div>
              <!-- Informations -->
              <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mb-4">
                <h6 class="footer-title">Information</h6>
                <hr class="footer-divider" />
                <p><a href="#" class="footer-link">Données personnelles</a></p>
                <p><a href="#" class="footer-link">Conditions générales de vente</a></p>
                <p><a href="#" class="footer-link">Mentions légales</a></p>
                <p><a href="#" class="footer-link">Autres</a></p>
              </div>
              <!-- Contact -->
              <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mb-md-0 mb-4">
                <h6 class="footer-title">Contact</h6>
                <hr class="footer-divider" />
                <p><i class="fa fa-home mr-3"></i> 34 Rue Antoine Primat, 69100 Villeurbanne</p>
                <p><i class="fa fa-envelope mr-3"></i> contact@vetenfant.com</p>
                <p><i class="fa fa-phone mr-3"></i> 04 74 48 60 15</p>
              </div>
            </div>
          </div>
        </section>

        <div class="text-center p-3 footer-bottom">
          <a class="footer-link" href="#">VetEnfant</a> © 2023-2026
        </div>
      </footer>
    </div>
  </main>

  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <!-- Popper.js -->
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
    integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
    crossorigin="anonymous"></script>
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"></script>
  <!-- fontawesome -->
  <script src="https://kit.fontawesome.com/45e38e596f.js" crossorigin="anonymous"></script>
</body>

</html>