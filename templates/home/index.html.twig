{% extends 'layout/base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<main>
    {% include 'components/banner.html.twig' with {
    banner_image: '/images/bannerHomePage.jpg',
    banner_title: "ÇA VIENT D'ARRIVER",
    banner_subtitle: "Ici, vous composez les vestiaires de vos kids\naussi vite qu’ils grandissent !",
    banner_button_link: "{{path('product_productNew')}}",
    banner_button_text: 'Tout voir'
    } %}

    {% if message %}
    <div class="alert alert-warning text-center">
        {{ message }}
    </div>
    {% endif %}

    {% include 'product/list.html.twig' with { 'products': products } %}

</main>
{% endblock %}
