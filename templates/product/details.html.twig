{% extends 'layout/base.html.twig' %}

{% block title %}Détails {{ product.name }}{% endblock %}

{% block body %}

<section class="bg-light p-3 p-md-4 p-xl-5 mt-5">
    <article class="container container-lg">
        <div class="row justify-content-center">
            <div class="col-12 col-xxl-11">
                <div class="card border-light-subtle shadow-sm">
                    <div class="row g-0 align-items-center">
                        <!-- Image à gauche -->
                        <div class="col-12 col-md-6">
                            <img src="{{ asset(product.image[0].src) }}" alt="{{ product.image[0].altText }}"
                                class="img-fluid rounded-start object-fit-cover mb-3 product-image" id="mainImage">
                            <div class="d-flex justify-content-between">
                                {% for image in product.image %}
                                <img src="{{ asset(image.src) }}" alt="{{ image.altText }}"
                                    class="thumbnail rounded mb-3 {% if loop.first %}active{% endif %}"
                                    onclick="changeImage(event, '{{ asset(image.src) }}')">
                                {% endfor %}
                            </div>
                        </div>

                        <!-- Formulaire à droite -->
                        <div class="col-12 col-md-6 d-flex align-items-center justify-content-center">
                            <div class="col-12 col-lg-11 col-xl-10">
                                <div class="card-body p-3 p-md-4 p-xl-5">
                                    <!-- Titre -->
                                    <h2 class="mb-3">{{ product.name }}</h2>
                                    <div class="text-muted mb-4 d-flex align-items-center">
                                        <a href="" class="text-decoration-none text-muted">
                                            <img src="{{product.user.profileImage}}" alt="Photo du vendeur"
                                                class="rounded-circle me-2" style="width: 40px; height: 40px;">
                                            <span>{{product.user.username}}</span>
                                        </a>
                                    </div>
                                    <div class="mb-3">
                                        <span class="h4 me-2">Prix : {{ product.price }} €</span>
                                    </div>
                                    <p class="mb-4 text-justify">{{ product.description }}</p>
                                    <div class="mb-4">
                                        <p class="product-detail"><strong>Taille :</strong> {{ product.getAgeCategory()
                                            }}</p>
                                        <p class="product-detail"><strong>État :</strong> {{ product.state.value }}</p>
                                    </div>

                                    <!-- Boutons -->
                                    <div class="d-grid"> {# ajouter un lien vers la page favoris #}
                                        {{ include('components/button.html.twig', { class: 'btn-general', label:
                                        'Ajouter aux favoris', type: 'submit' }) }}
                                    </div>
                                    <div class="d-grid"> {# ajouter un lien vers la page du vendeur #}
                                        {{ include('components/button.html.twig', { class: 'btn-general', label:
                                        'Contacter le vendeur', type: 'submit' }) }}
                                    </div>
                                    <div class="d-grid"> {# ajouter un #}
                                        {{ include('components/button.html.twig', { class: 'btn-general', label:
                                        'Ajouter au panier', type: 'submit' }) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </article>
</section>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function changeImage(event, src) {
        const mainImage = document.getElementById('mainImage');
        const thumbnails = document.querySelectorAll('.thumbnail');

        mainImage.src = src;
        thumbnails.forEach(thumb => thumb.classList.remove('active'));
        event.target.classList.add('active');
    }
</script>

{% endblock %}