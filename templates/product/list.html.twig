<section class="section-products mt-2">
    <div class="container custom-container">
        <div id="allProducts">
            <div class="row gx-4 gy-4 justify-content-center"> <!-- Added 'justify-content-center' for centering -->
                {% for product in products %}
                <div class="col-md-4 col-lg-4 col-xl-4"> <!-- Changed to 'col-md-4' to show 3 items per row -->
                    <div class="single-product">
                        <div class="product-header">
                            {% if product.image is not empty %}
                            <div class="image-container">
                                <img src="{{ asset(product.image[0].src) }}" class="product-image"
                                    alt="{{ product.image[0].altText }}">
                            </div>
                            {% else %}
                            <div
                                class="image-container bg-light text-muted d-flex justify-content-center align-items-center">
                                <p>Image non disponible</p>
                            </div>
                            {% endif %}
                        </div>
                        <div class="product-content">
                            <div class="d-flex justify-content-between align-items-center w-100">
                                <a class="text-decoration-none product-title text-muted" href="{{path('product_details', {"id": product.id}) }}">
                                    <h3 class="product-title mb-0">{{ product.name }}</h3>
                                </a>
                                <i class="fa fa-heart-o fa-lg favorite-icon"></i>
                            </div>
                            <h4 class="product-subTitle mt-4">
                                {{ product.description|length > 100 ? product.description[:100] ~ '...' :
                                product.description }}
                            </h4>
                            <h5 class="product-price mt-3">{{ product.price | number_format(2, ',', ' ') }} €</h5>

                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
