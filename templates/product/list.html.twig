<section class="section-products mt-2">
    <div class="container custom-container">
        <div id="allProducts">
            {% set productCount = 0 %}
            <div class="row gx-4 gy-5 justify-content-center"> <!-- gy-5 pour espacement vertical -->
                {% for product in products %}
                {% if productCount > 0 and productCount % 3 == 0 %}
            </div> <!-- Fermer la ligne -->
            <div class="row gx-4 gy-5 justify-content-center"> 
                {% endif %}
                {# Use component #}
                {{ include('components/card.html.twig')}}
                {% set productCount = productCount + 1 %}
                {% endfor %}
            </div> <!-- Fermer la dernière ligne -->
        </div>
    </div>
</section>