{% extends 'layout/base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<section class="bg-light p-3 p-md-4 p-xl-5 d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-xxl-11">
                <div class="card border-light-subtle shadow-sm">
                    <div class="row g-0">
                        <!-- Colonne Image -->
                        <div class="col-12 col-md-6">
                            <img 
                                class="img-fluid rounded-start w-100 h-100 object-fit-cover" 
                                style="height: 100%; max-height: 100%;" 
                                loading="lazy" 
                                src="{{ asset('/images/ForgetImage.jpg') }}" 
                                alt="PereAndFille"
                            >
                        </div>
                        <!-- Colonne Formulaire -->
                        <div class="col-12 col-md-6 d-flex align-items-center justify-content-center">
                            <div class="col-12 col-lg-11 col-xl-10">
                                <div class="card-body p-3 p-md-4 p-xl-5">
                                    <!-- Ajout de marge en haut -->
                                    <div class="mb-4">
                                        <div class="text-center mb-4">
                                            <a href="{{ path('app_home') }}">
                                                <img src="{{ asset('/images/LogoVet.png') }}" width="200" alt="VetEnfantLogo" />
                                            </a>
                                        </div>
                                        <h2 class="h4 text-center">Mot de passe oublié</h2>
                                        <h3 class="fs-6 fw-normal text-secondary text-center m-0">
                                            Indiquez l'adresse électronique associée à votre compte pour récupérer votre mot de passe.
                                        </h3>
                                    </div>
                                    <!-- Gestion des erreurs -->
                                    {% for flash_error in app.flashes('reset_password_error') %}
                                        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                                    {% endfor %}
                                    <!-- Formulaire -->
                                    {{ form_start(requestForm) }}
                                  
                                        <!-- Champ Email -->
                                        <div class="col-12">
                                            <div class="form-floating">
                                                {{ form_widget(requestForm.email, { 'attr': { 'class': 'form-control', 'placeholder': 'email' } }) }}
                                                <label for="email" class="form-label">Email</label>
                                            </div>
                                        </div>
                                        <!-- Bouton Submit -->
                                        <div class="col-12 mt-4">
                                            <div class="d-grid">
                                                <button class="btn-general" type="submit">Réinitialiser votre mot de passe</button>
                                            </div>
                                        </div>
                                                          
                                    {{ form_end(requestForm) }}
                                    <!-- Message sous le formulaire -->
                                    <div class="mt-3">
                                        <small>
                                            Saisissez votre adresse électronique et nous vous enverrons un lien pour réinitialiser votre mot de passe.
                                        </small>
                                    </div>
                                    <!-- Liens -->
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="d-flex gap-2 gap-md-4 flex-column flex-md-row justify-content-md-center mt-5">
                                                <a href="{{ path('app_logout') }}" class="link-secondary text-decoration-none">Se connecter</a>
                                                <a href="{{ path('app_register') }}" class="link-secondary text-decoration-none">Créer un compte</a>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Fin Contenu Formulaire -->
                                </div>
                            </div>
                        </div>
                        <!-- Fin Colonne Formulaire -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
