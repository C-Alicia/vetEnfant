{% extends 'layout/base.html.twig' %}

{% block body %}
<section class="bg-light p-3 p-md-4 p-xl-5 d-flex align-items-center justify-content-center" 
         style="min-height: 80vh; margin-top: 100px; padding-top: 60px; padding-bottom: 60px;">
    
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-xxl-11">
                <div class="card border-light-subtle shadow-sm">
                    <div class="row g-0">
                        <!-- Image en haut sur les petits écrans et à gauche sur les grands écrans -->
                        <div class="col-12 col-md-6">
                            <img class="img-fluid rounded-start w-80 h-100 object-fit-cover"
                                 src="{{ asset(image_path) }}" loading="lazy" alt="{{ image_alt }}">
                        </div>

                        <!-- Formulaire en dessous de l'image sur les petits écrans et à droite sur les grands écrans -->
                        <div class="col-12 col-md-6 d-flex align-items-center justify-content-center">
                            <div class="col-12 col-lg-11 col-xl-10">
                                <div class="card-body p-3 p-md-4 p-xl-5">
                                    <div class="text-center mb-5"> 
                                        <a href="{{ path('app_home') }}">
                                            <img src="{{ asset('/images/LogoVet.png') }}" width="200" alt="VetEnfantLogo" />
                                        </a>
                                        <h2 class="h4 mt-4">{% block form_title %}{% endblock %}</h2>
                                    </div>

                                    {% block form_content %}{% endblock %}
                                </div>
                            </div>
                        </div>
                    </div> 
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
