{% extends 'layout/base.html.twig' %}

{% block title %}
Modification du mot de passe de {{app.user.firstName}} {{app.user.lastName}}
{% endblock %}

{% block body %}

<section class="bg-light w-100">
	<div class="container-fluid">
		<div class="col-12 col-lg-10 col-xxl-11">
			{% for message in app.flashes('error') %}
			<div class="col-12 mb-3">
				<div class="alert alert-danger text-center" role="alert">
					{{ message }}
				</div>
			</div>
			{% endfor %}
		</div>
	</div>
	<div class="col-12 col-lg-10 col-xxl-11">
		{% for message in app.flashes('message') %}
			<div class="col-12 mb-3">
				<div class="alert alert-success text-center" role="alert">
					{{ message }}
				</div>
			</div>
		{% endfor %}
	</div>
	</div>
</section>
<section class="bg-light p-3 p-md-4 p-xl-5 mt-5 w-100" style="min-height: 50vh;">
	<div class="container-fluid">
		<h2 class="mt-5">Mot de passe :</h2>
		<div class="row align-items-center border-dotted rounded-3 mt-3 bg-white p-4 shadow-sm">

			<form method="POST">
				<div class="mb-3">
					<label label for="pass" class="form-label">Mot de passe :</label>
					<input type="password" id="pass" name="pass" class="form-control">
				</div>
				<div class="mb-3">
					<label label for="pass" class="form-label">Confirmer le mot de passe :</label>
					<input type="password" id="pass" name="pass2" class="form-control">
				</div>
				<button type="submit" class="btn btn-general">Valider</button>
			</form>
		</div>
	</div>
</section>

{% endblock %}