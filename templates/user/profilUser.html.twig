{% extends 'layout/base.html.twig' %}

{% block title %}Profil de {{app.user.firstName}} {{app.user.lastName}}{% endblock %}

{% block body %}
<section class="bg-light p-3 p-md-4 p-xl-5 mt-5 w-100" style="min-height: 100vh;">
    <div class="container-fluid">
        <div class="col-12 col-lg-10 col-xxl-11">
            {% for message in app.flashes('message') %}
                <div class="col-12 mb-3">
                    <div class="alert alert-success text-center" role="alert">
                        {{ message }}
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xxl-11">
                <div class="container mt-4">
                    <div class="card p-4">
                        <div class="row align-items-center border-dotted rounded-3 mt-3">
                            <div class="col-md-3 text-center">
                                {% if user.profileImage %}
                                <img src="{{ app.user.profileImage }}" alt="Profil" class="img-fluid rounded-circle"
                                    style="max-width: 250px;">
                                {% else %}
                                <img src="{{ asset('images/default-profile.png') }}" alt="Profil par défaut"
                                    class="img-fluid rounded-circle" style="max-width: 250px;">
                                {% endif %}
                                {# <!-- Formulaire de téléchargement d'image -->
                                <form method="post" enctype="multipart/form-data" action="">
                                    <input type="file" name="profile_image" class="form-control mt-3">
                                    <button type="submit" class="btn btn-general">Télécharger l'image</button>
                                </form> #}
                            </div>
                            <!-- Informations utilisateur -->
                            <div class="col-md-6">
                                <h2 class="d-flex justify-content-between align-items-center">
                                    {{ user.username }}

                                    <div class="btn-group" style="margin-left: 20px;">
                                        <!-- Ajout d'une marge entre le nom et les boutons -->
                                        <a href="{{path('profil_editProfil')}}">
                                            <button class="btn btn-general">
                                                <i class="fa fa-pencil"></i> Modifier
                                            </button>
                                        </a>
                                        <button class="btn btn-general">
                                            <i class="fa fa-trash"></i> Supprimer
                                        </button>
                                    </div>
                                </h2>

                                {% if user.evaluation %}
                                <p><strong>Evaluation :</strong> {{ user.evaluation }}</p>
                                {% else %}
                                <p>Aucune note trouvée.</p>
                                {% endif %}
                                <div class="row mt-3">
                                    <div class="col-md-12">
                                        <h4>À propos :</h4>
                                        <p>{{ user.description }}</p>
                                        <div class="text-muted" style="font-size: 0.9rem;">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <p><strong>Nom :</strong> {{ user.lastName }}</p>
                                                    <p><strong>Prénom :</strong> {{ user.firstName }}</p>
                                                    <p><strong>Téléphone :</strong> {{ user.phoneNumber }}</p>
                                                    <p><strong>Date de naissance :</strong> {{
                                                        user.dateOfBirth|date('d/m/Y') }}</p>
                                                </div>
                                                <div class="col-md-6">
                                                    {% if user.address is not empty %}
                                                    <p><strong>Adresse :</strong> {{ address.street }}</p>
                                                    <p><strong>Code postal :</strong> {{ address.postalCode }}</p>
                                                    <p><strong>Ville :</strong> {{ address.city }}</p>
                                                    {% else %}
                                                    <p>Aucune adresse trouvée.</p>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                            </div>
                        </div>

                        <!-- Dressing -->
                        <div class="row g-0 align-items-center">
                            {% include 'components/cardProfil.html.twig' with {
                            'icon_class': 'fa fa-shopping-bag',
                            'title': 'Dressing'
                            } %}
                        </div>
                        <div class="card p-4 mt-4">
                            <div class="card p-4 mt-4">

                            
                                {# {% if products is empty %}
                                    <p>Aucun produit dans votre dressing.</p>
                                {% else %}
                                    <div class="row">
                                        {% for product in products %}
                                            <div class="col-md-4">
                                                <div class="card">
                                                    <img src="{{ product.image }}" class="card-img-top" alt="{{ product.name }}">
                                                    <div class="card-body">
                                                        <h5 class="card-title">{{ product.name }}</h5>
                                                        <p class="card-text">{{ product.description }}</p>
                                                        <p class="text-muted">{{ product.price }} €</p>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %} #}
                            {# Ajouter les produits #}
                        </div>

                        <!-- Favoris -->
                        <div class="row g-0 align-items-center">
                            {% include 'components/cardProfil.html.twig' with {
                            'icon_class': 'fa fa-heart',
                            'title': 'Mes Favoris'
                            } %}
                        </div>
                        <div class="card p-4 mt-4">

                        </div>
                        <!-- Historique d'achat -->
                        <div class="row g-0 align-items-center">
                            {% include 'components/cardProfil.html.twig' with {
                            'icon_class': 'fa fa-history',
                            'title': 'Historique d\'achat'
                            } %}
                        </div>
                        <div class="card p-4 mt-4">

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock body %}