{% extends 'layout/base.html.twig' %}

{% block title %}Profil de {{profile.firstName}} {{profile.lastName}}{% endblock %}

{% block body %}
<section class="bg-light p-3 p-md-4 p-xl-5 mt-5 w-100" style="min-height: 100vh;">
    <div class="container-fluid">
        <div class="col-12 col-lg-10 col-xxl-11">
            {% for message in app.flashes('message') %}
            <div class="col-12 mb-3">
                <div class="alert alert-success text-center" role="alert">
                    {{ message }}
                </div>
            </div>
            {% endfor %}
        </div>
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xxl-11">
                <div class="container mt-4">
                    <div class="card p-4">
                        <div class="row align-items-center border-dotted rounded-3 mt-3">
                            <div class="col-md-3 text-center">
                                {% if profile.profileImage %}
                                <img src="{{ profile.profileImage }}" alt="Profil" class="img-fluid rounded-circle"
                                    style="max-width: 150px;">
                                {% else %}
                                <img src="{{ asset('images/default-profile.png') }}" alt="Profil par défaut"
                                    class="img-fluid rounded-circle" style="max-width: 150px;">
                                {% endif %}
                                {# <!-- Formulaire de téléchargement d'image -->
                                <form method="post" enctype="multipart/form-data" action="">
                                    <input type="file" name="profile_image" class="form-control mt-3">
                                    <button type="submit" class="btn btn-general">Télécharger l'image</button>
                                </form> #}
                            </div>
                            <!-- Informations utilisateur -->
                            <div class="col-md-6">
                                <h2 class="d-flex justify-content-between align-items-center">
                                    {{ profile.username }}

                                    <div class="btn-group" style="margin-left: 20px;">
                                        <!-- Ajout d'une marge entre le nom et les boutons -->
                                        {# <a href="{{path('edit_profile')}}"> #}
                                            <a href="{{ path('edit_profile', { 'id': app.user.id}) }}">
                                            <button class="btn btn-general">
                                                <i class="fa fa-pencil"></i> Modifier
                                            </button>
                                        </a>


                                        <button class="btn btn-general">
                                            <i class="fa fa-trash"></i> Supprimer
                                        </button>
                                    </div>
                                </h2>

                                {% if profile.evaluation %}
                                {% for i in 1..5 %}
                                {% if i <= profile.evaluation %} ⭐ {% else %} ☆ {% endif %} {% endfor %} </p>
                                    {% else %}
                                    <p>Aucune note trouvée.</p>
                                    {% endif %}
                                    <div class="row mt-3">
                                        <div class="col-md-12">
                                            <h4>À propos :</h4>
                                            <p>{{ profile.description }}</p>
                                            <div class="text-muted" style="font-size: 0.9rem;">
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <p><strong>Nom :</strong> {{ profile.lastName }}</p>
                                                        <p><strong>Prénom :</strong> {{ profile.firstName }}</p>
                                                        <p><strong>Téléphone :</strong> {{ profile.phoneNumber }}</p>
                                                        <p><strong>Date de naissance :</strong> {{
                                                            profile.dateOfBirth|date('d/m/Y') }}</p>
                                                    </div>

                                                    <div class="col-md-6">
                                                        {% if profile.address is empty %}
                                                        <p>Aucune adresse trouvée.</p>
                                                        {% else %}
                                                        {% endif %}
                                                        {% for address in profile.address %}
                                                        <p><strong>Adresse :</strong> {{ address.street }}</p>
                                                        <p><strong>Code postal :</strong> {{ address.postalCode }}</p>
                                                        <p><strong>Ville :</strong> {{ address.city }}</p>
                                                        {% endfor %}

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                            </div>
                        </div>

                        <!-- Dressing en premier -->
                        <div class="row g-0 align-items-center">
                            {% include 'components/cardProfil.html.twig' with {
                            'icon_class': 'fa fa-shopping-bag',
                            'title': 'Dressing'
                            } %}
                        </div>
                        <div class="row p-4 mt-4 border-dotted rounded-3">
                            {% if profile.products is empty %}
                            <p>Aucun produit dans votre dressing.</p>
                            {% else %}
                            <div class="row">
                                {% for product in profile.products %}
                                <div class="col-sm-6 col-md-4 col-lg-3 mb-3">
                                    <div class="card shadow-sm" style="max-width: 250px;">
                                        <img src="" class="card-img-top" alt="{{ product.name }}"
                                            style="height: 120px; object-fit: cover;">
                                        <div class="card-body p-2">
                                            <a class="text-decoration-none product-title text-muted"
                                                href="{{ path('product_details', {'slug': product.slug}) }}">
                                                <h6 class="card-title text-truncate" style="max-width: 200px;">{{
                                                    product.name }}</h6>
                                            </a>
                                            <p class="card-text small text-truncate" style="max-width: 200px;">{{
                                                product.description }}</p>
                                            <p class="text-muted small">{{ product.price }} €</p>
                                        </div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                            {% endif %}
                        </div>

                        <!-- Mes Favoris -->
                        <div class="row g-0 align-items-center">
                            {% include 'components/cardProfil.html.twig' with {
                            'icon_class': 'fa fa-heart',
                            'title': 'Mes Favoris'
                            } %}
                        </div>
                        <div class="row p-4 mt-4 border-dotted rounded-3">
                            <!-- Contenu des favoris -->
                        </div>

                        <!-- Historique d'achat -->
                        <div class="row g-0 align-items-center">
                            {% include 'components/cardProfil.html.twig' with {
                            'icon_class': 'fa fa-history',
                            'title': 'Historique d\'achat'
                            } %}
                        </div>
                        <div class="row p-4 mt-4 border-dotted rounded-3">
                            <!-- Contenu de l'historique d'achat -->
                        </div>
                    </div>







                    <!-- Favoris -->
                    {# <div class="row g-0 align-items-center">
                        {% include 'components/cardProfil.html.twig' with {
                        'icon_class': 'fa fa-heart',
                        'title': 'Mes Favoris'
                        } %}
                    </div>
                    <div class="row p-4 mt-4 border-dotted rounded-3">
                        #}
                        {# </div> #}
                    <!-- Historique d'achat -->
                    {# <div class="row g-0 align-items-center">
                        {% include 'components/cardProfil.html.twig' with {
                        'icon_class': 'fa fa-history',
                        'title': 'Historique d\'achat'
                        } %}
                    </div>
                    <div class="row p-4 mt-4 border-dotted rounded-3">

                    </div> #}
                </div>
            </div>
        </div>
    </div>
    </div>
</section>
{% endblock body %}