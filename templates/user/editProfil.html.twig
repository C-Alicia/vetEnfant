{% extends 'layout/base.html.twig' %}

{% block title %}Profil de {{ user.firstName }} {{ user.lastName }}{% endblock %}

{% block body %}
<section class="bg-light p-3 p-md-4 p-xl-5 d-flex align-items-center justify-content-center"
    style="min-height: 80vh; margin-top: 100px; padding-top: 60px; padding-bottom: 60px;">

    <div class="container-fluid">
        <h1 class="mb-4 text-uppercase fs-5">Gérez vos informations personnelles comme vous le souhaitez</h1>

        <h2 class="mb-3 fs-5">Données personnelles :</h2>
        <div class="row align-items-center border-dotted rounded-3 mt-3 bg-white p-4 shadow-sm">

            <form id="editProfileForm">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <h3 class="fs-5">Nom :</h3>
                            <input type="text" name="lastname" id="lastName" value="{{ user.lastName }}" class="form-control">
                        </div>
                        <div class="mb-3">
                            <h3 class="fs-5">Prénom :</h3>
                            <input type="text" name="firstname" id="firstName" value="{{ user.firstName }}" class="form-control">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <h3 class="fs-5">Date de naissance :</h3>
                            <input type="date" name="dateofbirth" id="dateOfBirth" value="{{ user.dateOfBirth|date('Y-m-d') }}" class="form-control">
                        </div>
                        <div class="mb-3">
                            <h3 class="fs-5">Numéro de téléphone :</h3>
                            <input type="text" name="phonenumber" id="phoneNumber" value="{{ user.phoneNumber }}" class="form-control">
                        </div>
                    </div>
                </div>

                <div class="text-end mt-3">
                    <button type="button" class="btn btn-general" id="updatePersonalInfo">Mettre à jour les informations</button>
                </div>
            </form>
        </div>

        <h2 class="mt-5 mb-3 fs-5">Mot de passe :</h2>

        <div class="row align-items-center border-dotted rounded-3 bg-white p-4 shadow-sm">
            <div class="col-md-12">
                <h3 class="fs-5 mb-3">Ici, vous pouvez changer votre mot de passe en toute sécurité :</h3>

                <div class="mb-3">
                    <label label for="pass" class="form-label mb-3">Mot de passe :</label>
                    <div class="col-auto mb-3">
                        <label for="inputPassword1" class="visually-hidden">Password</label>
                        <input type="password" class="form-control" id="inputPassword1" placeholder="Veuillez saisir un mot de passe">
                    </div>
                    <div class="col-auto mb-3">
                        <label for="inputPassword2" class="visually-hidden">Password</label>
                        <input type="password" class="form-control" id="inputPassword2" placeholder="Confirmez votre mot de passe">
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-general mb-3" id="updatePassword">Modifier le mot de passe</button>
                    </div>
                </div>
            </div>
        </div>

		<h2 class="mt-5 mb-3 fs-5">Addresse :</h2>

        {# <div class="row align-items-center border-dotted rounded-3 bg-white p-4 shadow-sm">
